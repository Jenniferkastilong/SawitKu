<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="12dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="8dp"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nama Kebun & Pemilik -->
        <TextView
            android:id="@+id/tv_judul"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dgreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Tanggal -->
        <TextView
            android:id="@+id/tv_tanggal"
            android:textSize="14sp"
            android:textColor="@color/gray"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Luas & Lokasi -->
        <TextView
            android:id="@+id/tv_luas"
            android:textSize="14sp"
            android:textColor="@color/dgray"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tv_lokasi"
            android:textSize="14sp"
            android:textColor="@color/dgray"
            android:layout_marginTop="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Foto kebun -->
        <ImageView
            android:id="@+id/iv_foto_kebun"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="#EEE"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Foto kebun"/>

        <!-- Tombol utama -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnDetail"
                android:text="Detail"
                android:backgroundTint="@color/green"
                android:textColor="@color/black"
                android:layout_marginEnd="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnVerify"
                android:text="Verifikasi"
                android:backgroundTint="@color/orange"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Tombol tambahan -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnPdf"
                android:text="PDF"
                android:backgroundTint="@color/lorange"
                android:textColor="@color/black"
                android:layout_marginEnd="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnCsv"
                android:text="CSV"
                android:backgroundTint="@color/lorange"
                android:textColor="@color/black"
                android:layout_marginEnd="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnDownloadFoto"
                android:text="Download Foto"
                android:backgroundTint="@color/lorange"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>