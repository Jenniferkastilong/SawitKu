<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet"> <View
    android:layout_width="40dp"
    android:layout_height="4dp"
    android:layout_gravity="center"
    android:background="#E0E0E0"
    android:layout_marginBottom="20dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulir Revisi Laporan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"/>
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_outline_gray"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgTargetRevisi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/sample_avatar"
            app:shapeAppearanceOverlay="@style/CircleImage"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/tvJudulLaporan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laporan Panen Q3"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvInfoPetani"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pak Slamet • ID: P-4029"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Catatan Revisi *"
        android:layout_marginTop="20dp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/etCatatanRevisi"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext_outline"
        android:gravity="top"
        android:padding="12dp"
        android:hint="Jelaskan bagian mana yang perlu diperbaiki..."
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnKirimRevisi"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:text="Kirim Revisi"
        android:textAllCaps="false"
        android:backgroundTint="#F47814"
        app:cornerRadius="28dp"/> <Button
        android:id="@+id/btnBatal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="Batal"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:cornerRadius="28dp"
        android:textColor="@color/black"
        app:strokeColor="#E0E0E0"/>
</LinearLayout>