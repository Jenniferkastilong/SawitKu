<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/login_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:layout_gravity="center"
        android:contentDescription="Logo Aplikasi" />

    <TextView
        android:id="@+id/text_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat datang di"
        android:textSize="14sp"
        android:paddingTop="16dp"
        android:fontFamily="@font/lexend"/>

    <TextView
        android:id="@+id/nama_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SawitKu"
        android:textSize="30sp"
        android:paddingBottom="16dp"
        android:textStyle="bold"
        android:fontFamily="@font/lexend"/>

    <Button
        android:id="@+id/button_login_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login"
        android:fontFamily="@font/lexend"
        android:backgroundTint="@color/orange"/>

    <Button
        android:id="@+id/button_register_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register"
        android:fontFamily="@font/lexend"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/dgreen"/>
</LinearLayout>