<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText android:id="@+id/etInputTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Judul Postingan" android:inputType="textCapSentences" />

    <EditText android:id="@+id/etInputTag"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:hint="Kategori" />

    <EditText android:id="@+id/etInputContent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:hint="Isi postingan..."
        android:minLines="3" android:gravity="top" />

    <Button android:id="@+id/btnPickImage"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Pilih Gambar" />

    <ImageView android:id="@+id/ivPreview"
        android:layout_width="match_parent" android:layout_height="150dp"
        android:layout_marginTop="10dp" android:visibility="gone"
        android:scaleType="centerCrop" />
</LinearLayout>