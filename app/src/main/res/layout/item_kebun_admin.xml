<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="10dp"
    card_view:cardElevation="4dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_margin="8dp"
        android:padding="8dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvNamaKebun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Kebun · (Pemilik)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLuasKebun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Luas: 0 Ha"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvStatusKebun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: -"
            android:layout_marginTop="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detail" />

            <Button
                android:id="@+id/btnDownloadFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Foto"
                android:layout_marginStart="6dp" />

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verifikasi"
                android:layout_marginStart="6dp" />

            <Button
                android:id="@+id/btnDeleteUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hapus Petani"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>